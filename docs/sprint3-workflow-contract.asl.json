{
  "Comment": "Integration example for Minh, not deployed by Quang's backend assembly. Use STANDARD workflow.",
  "StartAt": "Dispatch",
  "States": {
    "Dispatch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${DispatcherArn}", "Payload.$": "$"},
      "OutputPath": "$.Payload",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"], "IntervalSeconds": 2, "MaxAttempts": 2, "BackoffRate": 2}],
      "Next": "HasResult"
    },
    "HasResult": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.result", "IsPresent": true, "Next": "InitializeDelivery"}],
      "Default": "ActionRejected"
    },
    "ActionRejected": {"Type": "Fail", "Error": "ActionRejected", "Cause": "Action missing, unapproved, expired, changed schema, or already executing. Do not replay mutation."},
    "InitializeDelivery": {"Type": "Pass", "Result": {"attempt": 0}, "ResultPath": "$.delivery", "Next": "Format"},
    "Format": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${FormatterArn}", "Payload.$": "$"},
      "ResultPath": "$.formatted",
      "Retry": [{"ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 2, "MaxAttempts": 2, "BackoffRate": 2}],
      "Next": "Delivered"
    },
    "Delivered": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.formatted.Payload.publication_status", "StringEquals": "PUBLISHED", "Next": "Done"},
        {"Variable": "$.delivery.attempt", "NumericLessThan": 2, "Next": "IncrementDelivery"}
      ],
      "Default": "Done"
    },
    "IncrementDelivery": {"Type": "Pass", "Parameters": {"attempt.$": "States.MathAdd($.delivery.attempt, 1)"}, "ResultPath": "$.delivery", "Next": "WaitDelivery"},
    "WaitDelivery": {"Type": "Wait", "Seconds": 2, "Next": "Format"},
    "Done": {"Type": "Pass", "OutputPath": "$.formatted.Payload", "End": true}
  }
}
