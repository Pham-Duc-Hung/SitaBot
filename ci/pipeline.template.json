{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Author: Trinh Thien Quang - SatiBot Backend CI/CD Pipeline with Manual Approval, CDK Asset Publishing, TemplateConfiguration ChangeSet Deployment, and CodeDeploy Canary/Rollback.",
  "Parameters": {
    "ConnectionArn": {
      "Type": "String",
      "Default": ""
    },
    "RepositoryId": {
      "Type": "String",
      "Default": "TrinhThienQuang/SitaBot"
    },
    "PipelineRoleArn": {
      "Type": "String",
      "Default": ""
    },
    "BuildRoleArn": {
      "Type": "String",
      "Default": ""
    },
    "CloudFormationExecutionRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/cdk-hnb659fds-cfn-exec-role-789425597559-ap-southeast-1"
    },
    "ArtifactBucket": {
      "Type": "String",
      "Default": "cdk-hnb659fds-assets-789425597559-ap-southeast-1"
    },
    "Branch": {
      "Type": "String",
      "Default": "main"
    },
    "ApprovalNotificationTopicArn": {
      "Type": "String",
      "Default": ""
    },
    "BackendStackName": {
      "Type": "String",
      "Default": "SatiBotBackendSprint2"
    },
    "BackendChangeSetName": {
      "Type": "String",
      "Default": "satibot-backend-canary-changeset"
    },
    "ConfigurationReleaseId": {
      "Type": "String",
      "Default": "v1"
    },
    "CanaryDeploymentConfig": {
      "Type": "String",
      "Default": "CodeDeployDefault.LambdaCanary10Percent5Minutes"
    },
    "ConnectionsTableName": {
      "Type": "String",
      "Default": "SatiBot-AwsConnections"
    },
    "HistoryTableName": {
      "Type": "String",
      "Default": "SatiBot-ActionHistory"
    },
    "SessionStateTableName": {
      "Type": "String",
      "Default": "SatiBot-SessionState"
    },
    "PendingActionTableName": {
      "Type": "String",
      "Default": "SatiBot-PendingAction"
    },
    "GeminiSecretArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws[a-zA-Z-]*:secretsmanager:[a-z0-9-]+:\\d{12}:secret:.+$",
      "ConstraintDescription": "Provide a Secrets Manager ARN, never a plaintext API key."
    },
    "AppSyncGraphqlUrl": {
      "Type": "String",
      "Default": "https://3d7ef2bfnrgv5ebv3ca5cadkbu.appsync-api.ap-southeast-1.amazonaws.com/graphql"
    },
    "AppSyncApiArn": {
      "Type": "String",
      "Default": "arn:aws:appsync:ap-southeast-1:789425597559:apis/psmswy64qvba5pkfse2iuh44dm"
    },
    "ApiGatewaySourceArn": {
      "Type": "String",
      "Default": "arn:aws:execute-api:ap-southeast-1:789425597559:nbpr08jzuh/prod/*/*"
    },
    "FrontendOrigin": {
      "Type": "String",
      "Default": "https://satibot.id.vn",
      "AllowedPattern": "https?://[A-Za-z0-9.-]+(:[0-9]+)?",
      "Description": "Exact frontend origin matching CoreApiStack"
    },
    "GrantIntegrationPermissions": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "ChatbotRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-Chatbot-ExecutionRole"
    },
    "DispatcherRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-Dispatcher-ExecutionRole"
    },
    "FormatterRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-Formatter-ExecutionRole"
    },
    "ConnectorRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-Connector-ExecutionRole"
    },
    "HistoryRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-History-ExecutionRole"
    },
    "CodeDeployRoleArn": {
      "Type": "String",
      "Default": "arn:aws:iam::789425597559:role/SatiBot-CodeDeploy-LambdaRole"
    },
    "ChatbotAlarmName": {
      "Type": "String",
      "Default": ""
    },
    "DispatcherAlarmName": {
      "Type": "String",
      "Default": ""
    },
    "FormatterAlarmName": {
      "Type": "String",
      "Default": ""
    },
    "ConnectorAlarmName": {
      "Type": "String",
      "Default": ""
    },
    "HistoryAlarmName": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "CreateConnection": {
      "Fn::Equals": [
        {
          "Ref": "ConnectionArn"
        },
        ""
      ]
    },
    "CreatePipelineRole": {
      "Fn::Equals": [
        {
          "Ref": "PipelineRoleArn"
        },
        ""
      ]
    },
    "CreateBuildRole": {
      "Fn::Equals": [
        {
          "Ref": "BuildRoleArn"
        },
        ""
      ]
    },
    "HasApprovalNotificationTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApprovalNotificationTopicArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Connection": {
      "Type": "AWS::CodeConnections::Connection",
      "Properties": {
        "ConnectionName": "satibot-github",
        "ProviderType": "GitHub"
      },
      "Condition": "CreateConnection"
    },
    "DefaultBuildRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "CreateBuildRole",
      "Properties": {
        "RoleName": "SatiBot-CodeBuild-ServiceRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SatiBotCodeBuildPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}"
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sts:AssumeRole"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdk-hnb659fds-*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "DefaultPipelineRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "CreatePipelineRole",
      "Properties": {
        "RoleName": "SatiBot-CodePipeline-ServiceRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codepipeline.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SatiBotCodePipelinePolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:GetBucketVersioning",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}"
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codestar-connections:UseConnection",
                    "codeconnections:UseConnection"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codebuild:BatchGetBuilds",
                    "codebuild:StartBuild"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Build",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "PublishAssets",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:CreateChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DeleteChangeSet"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:PassRole"
                  ],
                  "Resource": [
                    {
                      "Ref": "CloudFormationExecutionRoleArn"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Build": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": {
          "Fn::If": [
            "CreateBuildRole",
            {
              "Fn::GetAtt": [
                "DefaultBuildRole",
                "Arn"
              ]
            },
            {
              "Ref": "BuildRoleArn"
            }
          ]
        },
        "Artifacts": {
          "Type": "CODEPIPELINE"
        },
        "Source": {
          "Type": "CODEPIPELINE",
          "BuildSpec": "ci/buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "EnvironmentVariables": [
            {
              "Name": "PRIMARY_REGION",
              "Value": "ap-southeast-1"
            },
            {
              "Name": "SECONDARY_REGION",
              "Value": "us-east-1"
            }
          ]
        },
        "TimeoutInMinutes": 30
      }
    },
    "PublishAssets": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": {
          "Fn::If": [
            "CreateBuildRole",
            {
              "Fn::GetAtt": [
                "DefaultBuildRole",
                "Arn"
              ]
            },
            {
              "Ref": "BuildRoleArn"
            }
          ]
        },
        "Artifacts": {
          "Type": "CODEPIPELINE"
        },
        "Source": {
          "Type": "CODEPIPELINE",
          "BuildSpec": "deployment/publish-buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "EnvironmentVariables": [
            {
              "Name": "AWS_DEFAULT_REGION",
              "Value": "ap-southeast-1"
            },
            {
              "Name": "PARAM_ConfigurationReleaseId",
              "Value": {
                "Ref": "ConfigurationReleaseId"
              }
            },
            {
              "Name": "PARAM_ConnectionsTableName",
              "Value": {
                "Ref": "ConnectionsTableName"
              }
            },
            {
              "Name": "PARAM_HistoryTableName",
              "Value": {
                "Ref": "HistoryTableName"
              }
            },
            {
              "Name": "PARAM_SessionStateTableName",
              "Value": {
                "Ref": "SessionStateTableName"
              }
            },
            {
              "Name": "PARAM_PendingActionTableName",
              "Value": {
                "Ref": "PendingActionTableName"
              }
            },
            {
              "Name": "PARAM_AppSyncGraphqlUrl",
              "Value": {
                "Ref": "AppSyncGraphqlUrl"
              }
            },
            {
              "Name": "PARAM_AppSyncApiArn",
              "Value": {
                "Ref": "AppSyncApiArn"
              }
            },
            {
              "Name": "PARAM_ApiGatewaySourceArn",
              "Value": {
                "Ref": "ApiGatewaySourceArn"
              }
            },
            {
              "Name": "PARAM_FrontendOrigin",
              "Value": {
                "Ref": "FrontendOrigin"
              }
            },
            {
              "Name": "PARAM_GrantIntegrationPermissions",
              "Value": {
                "Ref": "GrantIntegrationPermissions"
              }
            },
            {
              "Name": "PARAM_ChatbotRoleArn",
              "Value": {
                "Ref": "ChatbotRoleArn"
              }
            },
            {
              "Name": "PARAM_DispatcherRoleArn",
              "Value": {
                "Ref": "DispatcherRoleArn"
              }
            },
            {
              "Name": "PARAM_FormatterRoleArn",
              "Value": {
                "Ref": "FormatterRoleArn"
              }
            },
            {
              "Name": "PARAM_ConnectorRoleArn",
              "Value": {
                "Ref": "ConnectorRoleArn"
              }
            },
            {
              "Name": "PARAM_HistoryRoleArn",
              "Value": {
                "Ref": "HistoryRoleArn"
              }
            },
            {
              "Name": "PARAM_CodeDeployRoleArn",
              "Value": {
                "Ref": "CodeDeployRoleArn"
              }
            },
            {
              "Name": "PARAM_CanaryDeploymentConfig",
              "Value": {
                "Ref": "CanaryDeploymentConfig"
              }
            },
            {
              "Name": "PARAM_ChatbotAlarmName",
              "Value": {
                "Ref": "ChatbotAlarmName"
              }
            },
            {
              "Name": "PARAM_DispatcherAlarmName",
              "Value": {
                "Ref": "DispatcherAlarmName"
              }
            },
            {
              "Name": "PARAM_FormatterAlarmName",
              "Value": {
                "Ref": "FormatterAlarmName"
              }
            },
            {
              "Name": "PARAM_ConnectorAlarmName",
              "Value": {
                "Ref": "ConnectorAlarmName"
              }
            },
            {
              "Name": "PARAM_HistoryAlarmName",
              "Value": {
                "Ref": "HistoryAlarmName"
              }
            },
            {
              "Name": "PARAM_GeminiSecretArn",
              "Value": {
                "Ref": "GeminiSecretArn"
              }
            }
          ]
        },
        "TimeoutInMinutes": 15
      }
    },
    "Pipeline": {
      "Type": "AWS::CodePipeline::Pipeline",
      "Properties": {
        "RoleArn": {
          "Fn::If": [
            "CreatePipelineRole",
            {
              "Fn::GetAtt": [
                "DefaultPipelineRole",
                "Arn"
              ]
            },
            {
              "Ref": "PipelineRoleArn"
            }
          ]
        },
        "ArtifactStore": {
          "Type": "S3",
          "Location": {
            "Ref": "ArtifactBucket"
          }
        },
        "Stages": [
          {
            "Name": "Source",
            "Actions": [
              {
                "Name": "GitHub",
                "ActionTypeId": {
                  "Category": "Source",
                  "Owner": "AWS",
                  "Provider": "CodeStarSourceConnection",
                  "Version": "1"
                },
                "Configuration": {
                  "ConnectionArn": {
                    "Fn::If": [
                      "CreateConnection",
                      {
                        "Fn::GetAtt": [
                          "Connection",
                          "ConnectionArn"
                        ]
                      },
                      {
                        "Ref": "ConnectionArn"
                      }
                    ]
                  },
                  "FullRepositoryId": {
                    "Ref": "RepositoryId"
                  },
                  "BranchName": {
                    "Ref": "Branch"
                  },
                  "DetectChanges": "true"
                },
                "OutputArtifacts": [
                  {
                    "Name": "Source"
                  }
                ]
              }
            ]
          },
          {
            "Name": "BuildTestSynth",
            "Actions": [
              {
                "Name": "CI",
                "ActionTypeId": {
                  "Category": "Build",
                  "Owner": "AWS",
                  "Provider": "CodeBuild",
                  "Version": "1"
                },
                "Configuration": {
                  "ProjectName": {
                    "Ref": "Build"
                  }
                },
                "InputArtifacts": [
                  {
                    "Name": "Source"
                  }
                ],
                "OutputArtifacts": [
                  {
                    "Name": "BuildOutput"
                  }
                ]
              }
            ]
          },
          {
            "Name": "ManualApproval",
            "Actions": [
              {
                "Name": "ApproveBackendDeployment",
                "ActionTypeId": {
                  "Category": "Approval",
                  "Owner": "AWS",
                  "Provider": "Manual",
                  "Version": "1"
                },
                "Configuration": {
                  "CustomData": "X\u00e1c nh\u1eadn k\u1ebft qu\u1ea3 pytest, ki\u1ec3m tra g\u00f3i ZIP v\u00e0 CDK synth \u1edf b\u01b0\u1edbc BuildTestSynth tr\u01b0\u1edbc khi tri\u1ec3n khai Canary Backend l\u00ean ap-southeast-1.",
                  "NotificationArn": {
                    "Fn::If": [
                      "HasApprovalNotificationTopic",
                      {
                        "Ref": "ApprovalNotificationTopicArn"
                      },
                      {
                        "Ref": "AWS::NoValue"
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "Name": "DeployBackend",
            "Actions": [
              {
                "Name": "PublishCdkAssets",
                "RunOrder": 1,
                "Region": "ap-southeast-1",
                "ActionTypeId": {
                  "Category": "Build",
                  "Owner": "AWS",
                  "Provider": "CodeBuild",
                  "Version": "1"
                },
                "Configuration": {
                  "ProjectName": {
                    "Ref": "PublishAssets"
                  }
                },
                "InputArtifacts": [
                  {
                    "Name": "BuildOutput"
                  }
                ],
                "OutputArtifacts": [
                  {
                    "Name": "DeployConfig"
                  }
                ]
              },
              {
                "Name": "CreateReplaceChangeSet",
                "RunOrder": 2,
                "Region": "ap-southeast-1",
                "ActionTypeId": {
                  "Category": "Deploy",
                  "Owner": "AWS",
                  "Provider": "CloudFormation",
                  "Version": "1"
                },
                "InputArtifacts": [
                  {
                    "Name": "BuildOutput"
                  },
                  {
                    "Name": "DeployConfig"
                  }
                ],
                "Configuration": {
                  "ActionMode": "CHANGE_SET_REPLACE",
                  "StackName": {
                    "Ref": "BackendStackName"
                  },
                  "ChangeSetName": {
                    "Ref": "BackendChangeSetName"
                  },
                  "RoleArn": {
                    "Ref": "CloudFormationExecutionRoleArn"
                  },
                  "TemplatePath": "BuildOutput::cdk.out/SatiBotBackend.template.json",
                  "TemplateConfiguration": "DeployConfig::template-configuration.json",
                  "Capabilities": "CAPABILITY_NAMED_IAM,CAPABILITY_AUTO_EXPAND"
                }
              },
              {
                "Name": "ExecuteChangeSet",
                "RunOrder": 3,
                "Region": "ap-southeast-1",
                "ActionTypeId": {
                  "Category": "Deploy",
                  "Owner": "AWS",
                  "Provider": "CloudFormation",
                  "Version": "1"
                },
                "Configuration": {
                  "ActionMode": "CHANGE_SET_EXECUTE",
                  "StackName": {
                    "Ref": "BackendStackName"
                  },
                  "ChangeSetName": {
                    "Ref": "BackendChangeSetName"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "PipelineName": {
      "Value": {
        "Ref": "Pipeline"
      }
    },
    "BuildProjectName": {
      "Value": {
        "Ref": "Build"
      }
    },
    "AssetPublishProjectName": {
      "Value": {
        "Ref": "PublishAssets"
      }
    },
    "TargetBackendStackName": {
      "Value": {
        "Ref": "BackendStackName"
      }
    }
  }
}
